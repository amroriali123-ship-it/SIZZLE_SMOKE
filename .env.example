# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Server Port
PORT=3000

# Environment Mode: 'development' | 'production'
NODE_ENV="development"

# JWT Secret Key for Admin Authentication (change in production)
JWT_SECRET="sizzle_smoke_production_secret_key_change_me_2026"

# Allowed CORS Origin (e.g. GitHub Pages URL)
CORS_ORIGIN="https://amroriali123-ship-it.github.io"

# Optional MongoDB Atlas connection string (if using MongoDB instead of file storage)
MONGODB_URI="mongodb+srv://username:password@cluster.mongodb.net/sizzle_smoke?retryWrites=true&w=majority"

# Frontend API base URL (in GitHub Pages, set to your deployed backend URL, e.g. https://sizzle-smoke.onrender.com/api)
VITE_API_URL="/api"

